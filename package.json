{
    "name":  "unkora",
    "version":  "1.0.0",
    "private":  true,
    "description":  "Unkora Ã¢â‚¬â€ Premium Multi-Category E-Commerce Platform for Bangladesh",
    "engines":  {
                    "node":  "\u003e=20",
                    "pnpm":  "\u003e=9"
                },
    "scripts":  {
                    "dev":  "turbo dev --concurrency 20",
