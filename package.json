                    "start":  "turbo start",
                    "lint":  "turbo lint",
                    "lint:fix":  "turbo lint:fix",
                    "typecheck":  "turbo typecheck",
                    "test":  "turbo test",
                    "test:e2e":  "turbo test:e2e",
                    "clean":  "turbo clean \u0026\u0026 rimraf node_modules",
