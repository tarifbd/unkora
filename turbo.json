{
    "$schema":  "https://turbo.build/schema.json",
    "tasks":  {
                  "build":  {
                                "dependsOn":  [
                                                  "^build"
                                              ],
                                "outputs":  [
                                                ".next/**",
                                                "!.next/cache/**",
                                                "dist/**",
                                                "build/**"
                                            ],
                                "env":  [
                                            "PORT"
                                        ]
                            },
                  "dev":  {
                              "cache":  false,
                              "persistent":  true
                          },
                  "start":  {
                                "dependsOn":  [
                                                  "build"
                                              ],
                                "cache":  false,
                                "persistent":  true
                            },
                  "lint":  {
                               "outputs":  [

                                           ]
                           },
                  "lint:fix":  {
                                   "cache":  false,
                                   "outputs":  [

                                               ]
                               },
                  "typecheck":  {
                                    "dependsOn":  [
                                                      "^build"
                                                  ],
                                    "outputs":  [

                                                ]
                                },
                  "test":  {
                               "dependsOn":  [
                                                 "^build"
                                             ],
                               "outputs":  [
                                               "coverage/**"
                                           ],
                               "env":  [
                                           "TEST_DATABASE_URL",
                                           "TEST_MONGODB_URI",
                                           "TEST_REDIS_URL"
                                       ]
                           },
                  "test:e2e":  {
                                   "dependsOn":  [
                                                     "build"
                                                 ],
                                   "cache":  false,
                                   "outputs":  [
                                                   "playwright-report/**"
                                               ]
                               },
                  "clean":  {
                                "cache":  false,
                                "outputs":  [

                                            ]
                            },
                  "db:generate":  {
                                      "cache":  false,
                                      "outputs":  [
                                                      "node_modules/.prisma/**"
                                                  ]
                                  },
                  "db:push":  {
                                  "cache":  false
                              },
                  "db:migrate":  {
                                     "cache":  false
                                 },
                  "db:seed":  {
                                  "cache":  false,
                                  "dependsOn":  [
                                                    "db:migrate"
                                                ]
                              }
              },
    "remoteCache":  {
                        "enabled":  true
                    },
    "globalEnv":  [
                      "NODE_ENV",
                      "DATABASE_URL",
                      "MONGODB_URI",
                      "REDIS_URL",
                      "ELASTICSEARCH_URL",
                      "JWT_ACCESS_SECRET",
                      "JWT_REFRESH_SECRET",
                      "NEXTAUTH_SECRET",
                      "NEXTAUTH_URL",
                      "AWS_REGION",
                      "AWS_S3_BUCKET",
                      "AWS_CLOUDFRONT_URL",
                      "INTERNAL_API_SECRET",
                      "SENTRY_DSN"
                  ]
}
