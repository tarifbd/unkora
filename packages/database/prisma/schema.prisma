generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  VENDOR
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PACKED
  HANDED_TO_COURIER
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURN_APPROVED
  RETURN_RECEIVED
  REFUNDED
}

enum PaymentStatus {
  UNPAID
  PAID
  PARTIAL
  REFUNDED
  FAILED
}

enum PaymentMethod {
  SSLCOMMERZ
  BKASH
  NAGAD
  CARD
  COD
}

enum PaymentGateway {
  SSLCOMMERZ
  BKASH
  NAGAD
  CARD
  COD
}

enum CourierProvider {
  PATHAO
  STEADFAST
  REDX
  SA_PARIBAHAN
  SUNDARBAN
  MANUAL
}

enum DeliveryStatus {
  PENDING_PICKUP
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED_ATTEMPT
  RETURNED_TO_SENDER
  CANCELLED
}

enum DeliveryMethod {
  STANDARD
  EXPRESS
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum NotificationType {
  ORDER_STATUS
  PAYMENT
  PROMO
  SYSTEM
  REVIEW
  LOYALTY
}

enum LoyaltyTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum VendorStatus {
  PENDING
  APPROVED
  SUSPENDED
  REJECTED
}

enum BannerPosition {
  HERO
  CATEGORY
  SIDEBAR
  POPUP
  FLASH_SALE
}

enum AddressLabel {
  HOME
  WORK
  OTHER
}

enum Division {
  DHAKA
  CHITTAGONG
  SYLHET
  RAJSHAHI
  KHULNA
  BARISAL
  RANGPUR
  MYMENSINGH
}

enum BlacklistType {
  PHONE
  EMAIL
  ADDRESS
  IP
  DEVICE
}

model User {
  id                  String      @id @default(cuid())
  email               String?     @unique
  phone               String?     @unique
  password_hash       String?
  pin_hash            String?
  name_en             String
  name_bn             String?
  avatar              String?
  role                UserRole    @default(CUSTOMER)
  status              UserStatus  @default(ACTIVE)
  email_verified      Boolean     @default(false)
  phone_verified      Boolean     @default(false)
  two_factor_enabled  Boolean     @default(false)
  two_factor_secret   String?
  loyalty_points      Int         @default(0)
  loyalty_tier        LoyaltyTier @default(BRONZE)
  referral_code       String      @unique
  referred_by         String?
  last_login_at       DateTime?
  deleted_at          DateTime?
  created_at          DateTime    @default(now())
  updated_at          DateTime    @updatedAt

  sessions             UserSession[]
  addresses            Address[]
  cart                 Cart?
  orders               Order[]
  reviews              Review[]
  wishlists            Wishlist[]
  notifications        Notification[]
  loyalty_transactions LoyaltyTransaction[]
  vendor               Vendor?

  @@index([email])
  @@index([phone])
  @@index([role])
  @@index([status])
  @@map("users")
}

model UserSession {
  id                 String   @id @default(cuid())
  user_id            String
  device_fingerprint String
  device_name        String?
  ip_address         String
  user_agent         String
  is_trusted         Boolean  @default(false)
  last_active        DateTime @default(now())
  expires_at         DateTime
  created_at         DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
  @@map("user_sessions")
}

model Address {
  id             String       @id @default(cuid())
  user_id        String
  label          AddressLabel @default(HOME)
  recipient_name String
  phone          String
  division       Division
  district       String
  upazila        String
  union          String?
  street         String
  postal_code    String?
  is_default     Boolean      @default(false)
  created_at     DateTime     @default(now())
  updated_at     DateTime     @updatedAt

  user   User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([user_id])
  @@map("addresses")
}

model Category {
  id                  String   @id @default(cuid())
  name_en             String
  name_bn             String
  slug                String   @unique
  parent_id           String?
  icon                String?
  image               String?
  banner_image        String?
  meta_title          String?
  meta_title_bn       String?
  meta_description    String?
  meta_description_bn String?
  og_image            String?
  is_active           Boolean  @default(true)
  sort_order          Int      @default(0)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parent_id], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([slug])
  @@index([parent_id])
  @@index([is_active])
  @@map("categories")
}

model Brand {
  id                String   @id @default(cuid())
  name              String
  name_bn           String?
  slug              String   @unique
  logo              String?
  country_of_origin String?
  is_verified       Boolean  @default(false)
  description       String?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  products Product[]

  @@index([slug])
  @@map("brands")
}

model Product {
  id                   String        @id @default(cuid())
  sku                  String        @unique
  name_en              String
  name_bn              String
  slug                 String        @unique
  short_description_en String?
  short_description_bn String?
  description_en       String        @db.Text
  description_bn       String        @db.Text
  category_id          String
  brand_id             String?
  vendor_id            String?
  base_price           Int
  sale_price           Int?
  cost_price           Int?
  stock_quantity       Int           @default(0)
  low_stock_threshold  Int           @default(10)
  weight_grams         Int?
  is_active            Boolean       @default(true)
  is_featured          Boolean       @default(false)
  is_halal_certified   Boolean       @default(false)
  is_organic_certified Boolean       @default(false)
  publish_status       ProductStatus @default(DRAFT)
  views_count          Int           @default(0)
  sales_count          Int           @default(0)
  rating_average       Float         @default(0)
  rating_count         Int           @default(0)
  tags                 String[]
  meta_title           String?
  meta_title_bn        String?
  meta_description     String?
  meta_description_bn  String?
  og_image             String?
  deleted_at           DateTime?
  created_at           DateTime      @default(now())
  updated_at           DateTime      @updatedAt

  category               Category               @relation(fields: [category_id], references: [id])
  brand                  Brand?                 @relation(fields: [brand_id], references: [id])
  vendor                 Vendor?                @relation(fields: [vendor_id], references: [id])
  images                 ProductImage[]
  variants               ProductVariant[]
  book_detail            BookDetail?
  leather_detail         LeatherDetail?
  baby_product_detail    BabyProductDetail?
  islamic_product_detail IslamicProductDetail?
  organic_food_detail    OrganicFoodDetail?
  reviews                Review[]
  wishlists              Wishlist[]
  order_items            OrderItem[]
  cart_items             CartItem[]
  flash_sale_items       FlashSaleItem[]

  @@index([slug])
  @@index([sku])
  @@index([category_id])
  @@index([brand_id])
  @@index([vendor_id])
  @@index([publish_status])
  @@index([is_active])
  @@index([is_featured])
  @@index([base_price])
  @@index([rating_average])
  @@map("products")
}

model ProductImage {
  id          String   @id @default(cuid())
  product_id  String
  url         String
  alt_text    String?
  alt_text_bn String?
  sort_order  Int      @default(0)
  is_primary  Boolean  @default(false)
  width       Int?
  height      Int?
  created_at  DateTime @default(now())

  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([product_id])
  @@map("product_images")
}

model ProductVariant {
  id             String   @id @default(cuid())
  product_id     String
  sku            String   @unique
  name           String
  name_bn        String?
  attributes     Json
  price_modifier Int      @default(0)
  stock_quantity Int      @default(0)
  image          String?
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  product     Product     @relation(fields: [product_id], references: [id], onDelete: Cascade)
  cart_items  CartItem[]
  order_items OrderItem[]

  @@index([product_id])
  @@map("product_variants")
}

model BookDetail {
  id               String  @id @default(cuid())
  product_id       String  @unique
  isbn             String?
  author_en        String
  author_bn        String?
  publisher_en     String?
  publisher_bn     String?
  edition          String?
  pages            Int?
  language         String  @default("BN")
  genre            String?
  publication_year Int?
  is_islamic_book  Boolean @default(false)
  subject          String?
  binding_type     String?

  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@map("book_details")
}

model LeatherDetail {
  id                   String  @id @default(cuid())
  product_id           String  @unique
  leather_type         String
  color                String
  color_bn             String?
  dimensions           String?
  care_instructions_en String?
  care_instructions_bn String?
  hardware_material    String?
  lining_material      String?
  warranty_months      Int?

  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@map("leather_details")
}

model BabyProductDetail {
  id                    String   @id @default(cuid())
  product_id            String   @unique
  age_range_min_months  Int
  age_range_max_months  Int?
  material_en           String?
  material_bn           String?
  safety_certifications String[]
  choking_hazard        Boolean  @default(false)
  bpa_free              Boolean  @default(false)
  color_options         String[]
  washing_instructions  String?
  max_weight_kg         Float?

  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@map("baby_product_details")
}

model IslamicProductDetail {
  id                    String  @id @default(cuid())
  product_id            String  @unique
  arabic_name           String?
  halal_certificate_no  String?
  halal_certifying_body String?
  country_of_origin     String
  usage_instructions_en String?
  usage_instructions_bn String?
  usage_instructions_ar String?
  fragrance_notes       String?
  bead_count            Int?
  material              String?
  size                  String?

  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@map("islamic_product_details")
}

model OrganicFoodDetail {
  id                      String   @id @default(cuid())
  product_id              String   @unique
  organic_certified       Boolean  @default(false)
  certificate_no          String?
  certifying_body         String?
  origin_region           String?
  origin_region_bn        String?
  ingredients_en          String?
  ingredients_bn          String?
  nutritional_info        Json?
  expiry_months           Int?
  storage_instructions_en String?
  storage_instructions_bn String?
  net_weight_grams        Int?
  allergens               String[]

  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@map("organic_food_details")
}

model Cart {
  id          String    @id @default(cuid())
  user_id     String?   @unique
  session_id  String?   @unique
  coupon_code String?
  expires_at  DateTime?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  user  User?      @relation(fields: [user_id], references: [id], onDelete: SetNull)
  items CartItem[]

  @@index([session_id])
  @@map("carts")
}

model CartItem {
  id         String   @id @default(cuid())
  cart_id    String
  product_id String
  variant_id String?
  quantity   Int
  unit_price Int
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  cart    Cart            @relation(fields: [cart_id], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [product_id], references: [id])
  variant ProductVariant? @relation(fields: [variant_id], references: [id])

  @@unique([cart_id, product_id, variant_id])
  @@index([cart_id])
  @@map("cart_items")
}

model Order {
  id                      String          @id @default(cuid())
  order_number            String          @unique
  user_id                 String
  address_id              String?
  status                  OrderStatus     @default(PENDING)
  subtotal                Int
  shipping_cost           Int             @default(0)
  discount_amount         Int             @default(0)
  tax_amount              Int             @default(0)
  total_amount            Int
  payment_status          PaymentStatus   @default(UNPAID)
  payment_method          PaymentMethod
  shipping_address        Json
  delivery_method         DeliveryMethod  @default(STANDARD)
  estimated_delivery_date DateTime?
  actual_delivery_date    DateTime?
  tracking_number         String?
  courier                 CourierProvider?
  notes                   String?
  admin_notes             String?
  coupon_code             String?
  fraud_score             Int?
  deleted_at              DateTime?
  created_at              DateTime        @default(now())
  updated_at              DateTime        @updatedAt

  user              User               @relation(fields: [user_id], references: [id])
  address           Address?           @relation(fields: [address_id], references: [id])
  items             OrderItem[]
  status_history    OrderStatusHistory[]
  payment           Payment?
  delivery          Delivery?
  vendor_sub_orders VendorSubOrder[]

  @@index([user_id])
  @@index([order_number])
  @@index([status])
  @@index([payment_status])
  @@index([created_at])
  @@map("orders")
}

model OrderItem {
  id                 String  @id @default(cuid())
  order_id           String
  product_id         String
  variant_id         String?
  vendor_sub_order_id String?
  product_name_en    String
  product_name_bn    String?
  product_image      String
  sku                String
  quantity           Int
  unit_price         Int
  total_price        Int
  vendor_id          String?

  order         Order           @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product       Product         @relation(fields: [product_id], references: [id])
  variant       ProductVariant? @relation(fields: [variant_id], references: [id])
  vendor_sub_order VendorSubOrder? @relation(fields: [vendor_sub_order_id], references: [id])

  @@index([order_id])
  @@index([product_id])
  @@index([vendor_id])
  @@map("order_items")
}

model OrderStatusHistory {
  id         String      @id @default(cuid())
  order_id   String
  status     OrderStatus
  note       String?
  actor_id   String?
  actor_role UserRole?
  timestamp  DateTime    @default(now())

  order Order @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([order_id])
  @@map("order_status_history")
}

model VendorSubOrder {
  id                String      @id @default(cuid())
  order_id          String
  vendor_id         String
  subtotal          Int
  commission_amount Int
  vendor_payout     Int
  status            OrderStatus @default(PENDING)
  created_at        DateTime    @default(now())
  updated_at        DateTime    @updatedAt

  order  Order       @relation(fields: [order_id], references: [id], onDelete: Cascade)
  vendor Vendor      @relation(fields: [vendor_id], references: [id])
  items  OrderItem[]

  @@index([order_id])
  @@index([vendor_id])
  @@map("vendor_sub_orders")
}

model Payment {
  id                     String         @id @default(cuid())
  order_id               String         @unique
  transaction_id         String         @unique
  gateway_transaction_id String?
  gateway                PaymentGateway
  amount                 Int
  currency               String         @default("BDT")
  status                 PaymentStatus  @default(UNPAID)
  gateway_response       Json?
  refund_amount          Int?
  refund_reason          String?
  refunded_at            DateTime?
  idempotency_key        String         @unique
  created_at             DateTime       @default(now())
  updated_at             DateTime       @updatedAt

  order Order @relation(fields: [order_id], references: [id])

  @@index([transaction_id])
  @@index([status])
  @@map("payments")
}

model Delivery {
  id                     String          @id @default(cuid())
  order_id               String          @unique
  courier                CourierProvider
  consignment_id         String?
  tracking_url           String?
  status                 DeliveryStatus  @default(PENDING_PICKUP)
  pickup_date            DateTime?
  shipped_date           DateTime?
  expected_delivery_date DateTime?
  actual_delivery_date   DateTime?
  delivery_attempts      Int             @default(0)
  last_attempt_at        DateTime?
  failure_reason         String?
  proof_of_delivery_image String?
  agent_name             String?
  agent_phone            String?
  created_at             DateTime        @default(now())
  updated_at             DateTime        @updatedAt

  order          Order          @relation(fields: [order_id], references: [id])
  tracking_events TrackingEvent[]

  @@index([order_id])
  @@index([consignment_id])
  @@index([status])
  @@map("deliveries")
}

model TrackingEvent {
  id             String         @id @default(cuid())
  delivery_id    String
  status         DeliveryStatus
  location       String?
  description    String
  description_bn String?
  timestamp      DateTime       @default(now())

  delivery Delivery @relation(fields: [delivery_id], references: [id], onDelete: Cascade)

  @@index([delivery_id])
  @@map("tracking_events")
}

model DeliveryZone {
  id                 String          @id @default(cuid())
  division           Division
  district           String
  upazila            String?
  standard_days      Int
  express_days       Int
  standard_cost      Int
  express_cost       Int
  is_serviceable     Boolean         @default(true)
  cod_available      Boolean         @default(true)
  couriers_available String[]
  created_at         DateTime        @default(now())
  updated_at         DateTime        @updatedAt

  @@unique([division, district, upazila])
  @@index([division])
  @@index([district])
  @@index([is_serviceable])
  @@map("delivery_zones")
}

model Vendor {
  id                String       @id @default(cuid())
  user_id           String       @unique
  shop_name_en      String
  shop_name_bn      String?
  slug              String       @unique
  description_en    String?
  description_bn    String?
  logo              String?
  banner            String?
  phone             String
  email             String
  address           String
  division          Division
  district          String
  trade_license_no  String?
  tin               String?
  nid               String?
  bank_name         String?
  bank_account_no   String?
  bank_account_name String?
  bank_branch       String?
  bkash_number      String?
  commission_rate   Float        @default(10.0)
  status            VendorStatus @default(PENDING)
  rejection_reason  String?
  rating            Float        @default(0)
  total_orders      Int          @default(0)
  total_revenue     Int          @default(0)
  pending_payout    Int          @default(0)
  deleted_at        DateTime?
  created_at        DateTime     @default(now())
  updated_at        DateTime     @updatedAt

  user              User             @relation(fields: [user_id], references: [id])
  products          Product[]
  vendor_sub_orders VendorSubOrder[]
  documents         VendorDocument[]
  payouts           VendorPayout[]

  @@index([slug])
  @@index([status])
  @@map("vendors")
}

model VendorDocument {
  id          String   @id @default(cuid())
  vendor_id   String
  type        String
  url         String
  verified    Boolean  @default(false)
  uploaded_at DateTime @default(now())

  vendor Vendor @relation(fields: [vendor_id], references: [id], onDelete: Cascade)

  @@index([vendor_id])
  @@map("vendor_documents")
}

model VendorPayout {
  id             String    @id @default(cuid())
  vendor_id      String
  amount         Int
  period_start   DateTime
  period_end     DateTime
  status         String    @default("PENDING")
  payment_method String?
  payment_ref    String?
  paid_at        DateTime?
  notes          String?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  vendor Vendor @relation(fields: [vendor_id], references: [id])

  @@index([vendor_id])
  @@index([status])
  @@map("vendor_payouts")
}

model Review {
  id                   String   @id @default(cuid())
  product_id           String
  user_id              String
  order_id             String
  rating               Int
  title                String?
  body                 String   @db.Text
  images               String[]
  is_verified_purchase Boolean  @default(false)
  is_approved          Boolean  @default(false)
  helpful_count        Int      @default(0)
  admin_reply          String?
  admin_reply_at       DateTime?
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  product Product @relation(fields: [product_id], references: [id])
  user    User    @relation(fields: [user_id], references: [id])

  @@unique([product_id, user_id, order_id])
  @@index([product_id])
  @@index([user_id])
  @@index([is_approved])
  @@map("reviews")
}

model Wishlist {
  id         String   @id @default(cuid())
  user_id    String
  product_id String
  created_at DateTime @default(now())

  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([user_id, product_id])
  @@index([user_id])
  @@map("wishlists")
}

model Coupon {
  id                    String     @id @default(cuid())
  code                  String     @unique
  type                  CouponType
  value                 Int
  min_order_amount      Int?
  max_discount_amount   Int?
  usage_limit           Int?
  per_user_limit        Int        @default(1)
  used_count            Int        @default(0)
  valid_from            DateTime
  valid_until           DateTime
  applicable_categories String[]
  applicable_products   String[]
  excluded_products     String[]
  is_active             Boolean    @default(true)
  is_auto_apply         Boolean    @default(false)
  description           String?
  created_at            DateTime   @default(now())
  updated_at            DateTime   @updatedAt

  @@index([code])
  @@index([is_active])
  @@index([valid_until])
  @@map("coupons")
}

model Notification {
  id         String           @id @default(cuid())
  user_id    String
  type       NotificationType
  title_en   String
  title_bn   String
  body_en    String
  body_bn    String
  is_read    Boolean          @default(false)
  read_at    DateTime?
  action_url String?
  image      String?
  data       Json?
  created_at DateTime         @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([is_read])
  @@index([created_at])
  @@map("notifications")
}

model LoyaltyTransaction {
  id             String   @id @default(cuid())
  user_id        String
  points         Int
  type           String
  reference_id   String?
  description    String
  description_bn String
  balance_after  Int
  expires_at     DateTime?
  created_at     DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([type])
  @@map("loyalty_transactions")
}

model FlashSale {
  id           String    @id @default(cuid())
  name_en      String
  name_bn      String
  start_time   DateTime
  end_time     DateTime
  banner_image String?
  is_active    Boolean   @default(true)
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  items FlashSaleItem[]

  @@index([start_time])
  @@index([end_time])
  @@index([is_active])
  @@map("flash_sales")
}

model FlashSaleItem {
  id                  String    @id @default(cuid())
  flash_sale_id       String
  product_id          String
  discount_percentage Int
  sale_price          Int
  max_quantity        Int
  sold_count          Int       @default(0)
  created_at          DateTime  @default(now())

  flash_sale FlashSale @relation(fields: [flash_sale_id], references: [id], onDelete: Cascade)
  product    Product   @relation(fields: [product_id], references: [id])

  @@unique([flash_sale_id, product_id])
  @@index([flash_sale_id])
  @@map("flash_sale_items")
}

model Banner {
  id               String         @id @default(cuid())
  title_en         String
  title_bn         String?
  image_url        String
  mobile_image_url String?
  link             String?
  position         BannerPosition @default(HERO)
  start_date       DateTime?
  end_date         DateTime?
  is_active        Boolean        @default(true)
  sort_order       Int            @default(0)
  click_count      Int            @default(0)
  created_at       DateTime       @default(now())
  updated_at       DateTime       @updatedAt

  @@index([position])
  @@index([is_active])
  @@map("banners")
}

model Blacklist {
  id         String        @id @default(cuid())
  type       BlacklistType
  value      String
  reason     String
  added_by   String
  is_active  Boolean       @default(true)
  created_at DateTime      @default(now())
  updated_at DateTime      @updatedAt

  @@unique([type, value])
  @@index([type])
  @@index([is_active])
  @@map("blacklists")
}

model SearchLog {
  id            String   @id @default(cuid())
  query         String
  results_count Int      @default(0)
  user_id       String?
  session_id    String?
  created_at    DateTime @default(now())

  @@index([query])
  @@index([created_at])
  @@map("search_logs")
}

model AuditLog {
  id          String   @id @default(cuid())
  actor_id    String?
  action      String
  entity      String
  entity_id   String?
  old_data    Json?
  new_data    Json?
  ip_address  String?
  created_at  DateTime @default(now())

  @@index([actor_id])
  @@index([entity])
  @@index([entity_id])
  @@index([created_at])
  @@map("audit_logs")
}
