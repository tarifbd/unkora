# ─────────────────────────────────────────────
#  Unkora — Environment Variables Template
#  Copy to .env and fill all values
# ─────────────────────────────────────────────

# ── GENERAL ───────────────────────────────────
NODE_ENV=development
INTERNAL_API_SECRET=change_this_super_secret_internal_key_32chars

# ── DATABASE — PostgreSQL ─────────────────────
POSTGRES_USER=unkora
POSTGRES_PASSWORD=unkora_secret_dev
POSTGRES_DB=unkora
DATABASE_URL=postgresql://unkora:unkora_secret_dev@localhost:5432/unkora

# ── DATABASE — MongoDB ────────────────────────
MONGO_USER=unkora
MONGO_PASSWORD=unkora_secret_dev
MONGODB_URI=mongodb://unkora:unkora_secret_dev@localhost:27017/unkora?authSource=admin

# ── DATABASE — Redis ──────────────────────────
REDIS_PASSWORD=unkora_secret_dev
REDIS_URL=redis://:unkora_secret_dev@localhost:6379

# ── DATABASE — Elasticsearch ──────────────────
ELASTICSEARCH_URL=http://localhost:9200

# ── AUTH ──────────────────────────────────────
JWT_ACCESS_SECRET=generate_with_openssl_rand_hex_64_access
JWT_REFRESH_SECRET=generate_with_openssl_rand_hex_64_refresh
NEXTAUTH_SECRET=generate_with_openssl_rand_hex_32
NEXTAUTH_URL=http://localhost:3000

# OAuth Providers
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
FACEBOOK_CLIENT_ID=your_facebook_app_id
FACEBOOK_CLIENT_SECRET=your_facebook_app_secret

# ── SMS — SSL Wireless (BD) ───────────────────
SSL_WIRELESS_API_KEY=your_ssl_wireless_api_key
SSL_WIRELESS_SID=your_ssl_wireless_sid
SSL_WIRELESS_CSMS_ID=your_csms_id

# ── SMS — Twilio (fallback) ───────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+12xxxxxxxxxx

# ── EMAIL ─────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@unkora.com
SMTP_PASS=your_smtp_app_password
EMAIL_FROM="Unkora <noreply@unkora.com>"
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# ── AWS ───────────────────────────────────────
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_S3_BUCKET=unkora-assets-dev
AWS_CLOUDFRONT_URL=https://dxxxxxxxxxx.cloudfront.net

# ── PAYMENT — SSLCommerz ─────────────────────
SSLCOMMERZ_STORE_ID=your_store_id
SSLCOMMERZ_STORE_PASS=your_store_pass
SSLCOMMERZ_IS_LIVE=false
SSLCOMMERZ_SUCCESS_URL=http://localhost:3000/checkout/success
SSLCOMMERZ_FAIL_URL=http://localhost:3000/checkout/fail
SSLCOMMERZ_CANCEL_URL=http://localhost:3000/checkout/cancel
SSLCOMMERZ_IPN_URL=http://localhost:4004/webhooks/sslcommerz/ipn

# ── PAYMENT — bKash ───────────────────────────
BKASH_APP_KEY=your_bkash_app_key
BKASH_APP_SECRET=your_bkash_app_secret
BKASH_USERNAME=your_bkash_username
BKASH_PASSWORD=your_bkash_password
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_CALLBACK_URL=http://localhost:3000/checkout/bkash-callback

# ── PAYMENT — Nagad ───────────────────────────
NAGAD_MERCHANT_ID=your_nagad_merchant_id
NAGAD_MERCHANT_PRIVATE_KEY=your_rsa_private_key_base64
NAGAD_MERCHANT_PUBLIC_KEY=your_rsa_public_key_base64
NAGAD_BASE_URL=http://sandbox.mynagad.com:10080
NAGAD_CALLBACK_URL=http://localhost:3000/checkout/nagad-callback

# ── COURIER — Pathao ─────────────────────────
PATHAO_CLIENT_ID=your_pathao_client_id
PATHAO_CLIENT_SECRET=your_pathao_client_secret
PATHAO_USERNAME=your_pathao_username
PATHAO_PASSWORD=your_pathao_password
PATHAO_BASE_URL=https://hermes.pathao.com/api/v1
PATHAO_STORE_ID=your_store_id

# ── COURIER — Steadfast ──────────────────────
STEADFAST_API_KEY=your_steadfast_api_key
STEADFAST_SECRET_KEY=your_steadfast_secret_key

# ── COURIER — RedX ───────────────────────────
REDX_API_KEY=your_redx_api_key
REDX_BASE_URL=https://openapi.redx.com.bd/v1.0.0-beta

# ── MARKETING — Facebook ─────────────────────
FB_ACCESS_TOKEN=your_facebook_access_token
FB_PIXEL_ID=your_pixel_id
FB_CATALOG_ID=your_catalog_id

# ── MARKETING — Google ────────────────────────
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
GA4_API_SECRET=your_ga4_api_secret
GOOGLE_MERCHANT_ID=your_merchant_center_id

# ── MARKETING — TikTok ───────────────────────
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token
TIKTOK_PIXEL_ID=your_tiktok_pixel_id

# ── PUSH NOTIFICATIONS ────────────────────────
VAPID_PUBLIC_KEY=generate_with_npx_web_push_generate-vapid-keys
VAPID_PRIVATE_KEY=generate_with_npx_web_push_generate-vapid-keys

# ── STORAGE — MinIO (dev) ─────────────────────
MINIO_ROOT_USER=unkora
MINIO_ROOT_PASSWORD=unkora_secret_2024

# ── OBSERVABILITY ────────────────────────────
GRAFANA_PASSWORD=admin_change_in_prod
SENTRY_DSN=https://xxxxxxxx@oxxxxxxxxx.ingest.sentry.io/xxxxxxx

# ── FRONTEND ─────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_VAPID_PUBLIC_KEY=${VAPID_PUBLIC_KEY}
